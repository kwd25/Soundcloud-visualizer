# Neon Postgres connection string
DATABASE_URL=

# SoundCloud OAuth app credentials (https://developers.soundcloud.com)
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=

# Auth.js session secret — generate with: openssl rand -base64 32
AUTH_SECRET=

# Public app URL (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Inngest (optional in local dev; required for prod)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Anthropic API key for AI community labeling
ANTHROPIC_API_KEY=
